NODE_API_URL=http://localhost:3001
INTERNAL_API_KEY=change-me-in-production
SCRAPE_INTERVAL_MINUTES=15
SCRAPE_TIMEOUT_SECONDS=30

# Bilibili risk control bans an IP after only a couple of rapid requests.
# Scrape rarely, and stay away much longer once rejected (-799 / -412).
BILIBILI_MIN_SCRAPE_INTERVAL_MINUTES=360
BILIBILI_BACKOFF_MINUTES=720
COMMUNITY_MIN_SCRAPE_INTERVAL_MINUTES=360
# Full browser cookie string for a logged-in Bilibili account. Contains a live
# session (SESSDATA/bili_jct) — set it in the deployed .env only, never commit it.
BILIBILI_COOKIE=
